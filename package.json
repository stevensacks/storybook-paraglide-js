{
    "name": "storybook-paraglide-js",
    "version": "10.0.2",
    "description": "Add Paraglide JS support to Storybook",
    "keywords": [
        "storybook-addons",
        "storybook-i18n",
        "paraglide",
        "paraglide-js",
        "inlang",
        "i18n",
        "localization",
        "internationalization"
    ],
    "bugs": {
        "url": "https://github.com/stevensacks/storybook-paraglide-js/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stevensacks/storybook-paraglide-js.git"
    },
    "license": "MIT",
    "author": "Steven Sacks",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./preview": {
            "types": "./dist/preview.d.ts",
            "default": "./dist/preview.js"
        },
        "./manager": "./dist/manager.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "manager.js",
        "manager.d.ts",
        "preview.js",
        "preview.d.ts"
    ],
    "scripts": {
        "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
        "build": "tsup",
        "postbuild": "node scripts/check-exports.js",
        "prebuild-storybook": "npm run paraglide",
        "build-storybook": "storybook build",
        "build:watch": "pnpm run build --watch",
        "eject-ts": "zx scripts/eject-typescript.js",
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "lint:fix": "pnpm lint --fix",
        "prepack": "node scripts/check-exports.js",
        "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
        "paraglide:watch": "npm run paraglide -- --watch",
        "prerelease": "zx scripts/prepublish-checks.js",
        "release": "set -a && . ./.env && set +a && pnpm run build && auto shipit",
        "start": "run-p build:watch paraglide:watch \"storybook --quiet\"",
        "prestorybook": "npm run paraglide",
        "storybook": "storybook dev -p 6006",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "dependencies": {
        "storybook-i18n": "^10.1.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@inlang/paraglide-js": "^2.25.2",
        "@storybook/react-vite": "^10.0.0",
        "@types/node": "^20",
        "@types/react": "^18.2.65",
        "@types/react-dom": "^18.2.21",
        "@vitejs/plugin-react": "^4.7.0",
        "auto": "^11.3.0",
        "boxen": "^8.0.1",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-storybook": "^10.0.0",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.6.2",
        "prompts": "^2.4.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "storybook": "^10.0.0",
        "ts-dedent": "^2.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.44.1",
        "vite": "^7.0.5",
        "zx": "^8.7.1"
    },
    "peerDependencies": {
        "@inlang/paraglide-js": "^2.0.0",
        "storybook": "^9.0.0 || ^10.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "bundler": {
        "exportEntries": [
            "src/index.ts"
        ],
        "managerEntries": [
            "src/manager.ts"
        ],
        "previewEntries": [
            "src/preview.ts"
        ],
        "nodeEntries": []
    },
    "storybook": {
        "displayName": "Storybook Paraglide JS addon",
        "supportedFrameworks": [
            "react",
            "svelte",
            "vue",
            "solid",
            "web-components",
            "angular"
        ],
        "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
    },
    "overrides": {
        "storybook": "$storybook"
    },
    "packageManager": "pnpm@10.0.0",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
