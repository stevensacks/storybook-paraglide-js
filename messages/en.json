{
    "$schema": "https://inlang.com/schema/inlang-message-format",
    "hello": "Hello",
    "world": "World",
    "click": [
        {
            "declarations": [
                "input count",
                "local countPlural = count: plural"
            ],
            "selectors": ["countPlural"],
            "match": {
                "countPlural=one": "Clicked {count} time",
                "countPlural=*": "Clicked {count} times"
            }
        }
    ]
}
